# Copie para .env antes do docker compose up
POSTGRES_PASSWORD=troque-esta-senha
SECRET_KEY=gere-com-openssl-rand-hex-32
# Token do conector do Claude (MCP). Deixe vazio para desligar.
# Gere no PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })
MCP_TOKEN=

# Planilha FECHAMENTO pelo Google (opcional): coloque a chave em credenciais/google.json
# GOOGLE_SERVICE_ACCOUNT_FILE=/app/credenciais/google.json

# Pasta monitorada (extratos baixados pelos robôs / Claude in Chrome). No Windows, ex.: C:/FinBPO/extratos
# EXTRATOS_PASTA_HOST=C:/FinBPO/extratos
# Entidade dos arquivos soltos na raiz da pasta (id da corretora no FinBPO). Subpastas com o id ou CNPJ escolhem outra.
# EXTRATOS_ENTIDADE_ID=1

# LGPD (ver docs/LGPD.md)
# DADOS_CHAVE=           # chave própria dos CPFs cifrados (base64, 64 bytes); defina ANTES do primeiro uso
# MCP_MASCARAR_PF=true    # Claude recebe CPF e nome de pessoa física mascarados
# RETENCAO_ARQUIVOS_DIAS=90

# E-mail: alerta diário e fechamento do mês (ver docs/EMAIL.md)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORTA=587
# SMTP_USUARIO=seu-email@gmail.com
# SMTP_SENHA=senha-de-app-de-16-letras
# ALERTAS_DESTINATARIOS=seu-email@gmail.com
# ALERTAS_HORA=7
# FECHAMENTO_DIA=5
