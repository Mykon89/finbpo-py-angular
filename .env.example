# Copie para .env antes do docker compose up
POSTGRES_PASSWORD=troque-esta-senha
SECRET_KEY=gere-com-openssl-rand-hex-32
# Token do conector do Claude (MCP). Deixe vazio para desligar.
# Gere no PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })
MCP_TOKEN=

# Planilha FECHAMENTO pelo Google (opcional): coloque a chave em credenciais/google.json
# GOOGLE_SERVICE_ACCOUNT_FILE=/app/credenciais/google.json
